<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <AssemblyName>WitheredRose</AssemblyName>
    <RootNamespace>HypixelStatsOverlay</RootNamespace>
    <Platforms>x64</Platforms>
    <Product>WitheredRose</Product>
    <AssemblyTitle>WitheredRose</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Fonts\Monocraft.ttf" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\logo.ico" />
    <Resource Include="Assets\signature_watermark.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

</Project>
